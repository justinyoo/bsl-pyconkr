{
  "openapi": "3.0.4",
  "info": {
    "title": "Battle School Lunch API",
    "description": "급식 배틀 앱의 프론트엔드-백엔드 내부 API 계약입니다. 이 계약은 NEIS 원본 API(`data/openapi.json`)를 직접 노출하지 않고, 백엔드가 정규화한 학교 검색과 중식 조회 결과만 제공합니다.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "프론트엔드가 상대 경로로 호출하는 백엔드 내부 API"
    }
  ],
  "tags": [
    { "name": "Health", "description": "백엔드 생존 확인" },
    { "name": "Schools", "description": "학교 검색" },
    { "name": "Meals", "description": "날짜 범위별 중식 조회" }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "백엔드 생존 확인",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "백엔드가 정상 동작 중임",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" },
                "example": { "status": "ok" }
              }
            }
          }
        }
      }
    },
    "/schools": {
      "get": {
        "tags": ["Schools"],
        "summary": "부분 학교명 검색",
        "operationId": "searchSchools",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": true,
            "description": "검색할 학교명의 일부. 앞뒤 공백을 제거한 후 2자 이상이어야 한다.",
            "schema": { "type": "string", "minLength": 2, "maxLength": 100 },
            "example": "서울고"
          }
        ],
        "responses": {
          "200": {
            "description": "검색 결과 목록. 결과가 없으면 빈 배열을 반환한다.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SchoolSearchResponse" },
                "example": {
                  "items": [
                    {
                      "schoolCode": "7010113",
                      "educationOfficeCode": "B10",
                      "schoolName": "서울고등학교",
                      "educationOfficeName": "서울특별시교육청",
                      "locationName": "서울특별시",
                      "schoolType": "고등학교"
                    }
                  ],
                  "total": 1
                }
              }
            }
          },
          "400": {
            "description": "검색어가 누락되었거나 2자 미만인 경우",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetail" },
                "example": {
                  "type": "https://example.invalid/problems/invalid-request",
                  "title": "Invalid request",
                  "status": 400,
                  "detail": "검색어는 공백을 제거한 후 2자 이상이어야 합니다.",
                  "instance": "/api/v1/schools",
                  "code": "INVALID_REQUEST",
                  "errors": { "name": ["검색어는 2자 이상 입력해 주세요."] }
                }
              }
            }
          },
          "429": {
            "description": "요청이 제한된 경우",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetail" }
              }
            }
          },
          "502": {
            "description": "NEIS가 처리 불가능한 오류를 반환한 경우",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetail" }
              }
            }
          },
          "503": {
            "description": "NEIS 연결 실패 또는 타임아웃",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetail" }
              }
            }
          }
        }
      }
    },
    "/schools/{schoolCode}/meals": {
      "get": {
        "tags": ["Meals"],
        "summary": "날짜 범위의 중식 조회",
        "operationId": "getSchoolMeals",
        "parameters": [
          {
            "name": "schoolCode",
            "in": "path",
            "required": true,
            "description": "NEIS 행정표준코드",
            "schema": { "type": "string", "minLength": 1, "maxLength": 20 },
            "example": "7010113"
          },
          {
            "name": "officeCode",
            "in": "query",
            "required": true,
            "description": "시도교육청 코드",
            "schema": { "type": "string", "minLength": 1, "maxLength": 20 },
            "example": "B10"
          },
          {
            "name": "from",
            "in": "query",
            "required": true,
            "description": "한국 표준시 기준 직전 달 1일 이상, 오늘 이하",
            "schema": { "type": "string", "format": "date" },
            "example": "2026-08-10"
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "description": "from 이상이며 한국 표준시 기준 오늘 이하",
            "schema": { "type": "string", "format": "date" },
            "example": "2026-08-17"
          }
        ],
        "responses": {
          "200": {
            "description": "조회 기간 중 급식이 존재하는 날짜의 중식 목록. 날짜 오름차순이며 급식이 없는 날짜는 포함하지 않는다.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MealRangeResponse" },
                "example": {
                  "school": {
                    "schoolCode": "7010113",
                    "educationOfficeCode": "B10",
                    "schoolName": "서울고등학교",
                    "educationOfficeName": "서울특별시교육청"
                  },
                  "from": "2026-08-10",
                  "to": "2026-08-17",
                  "meals": [
                    {
                      "date": "2026-08-17",
                      "mealType": "lunch",
                      "dishes": ["현미밥", "미역국", "닭갈비"],
                      "origins": ["쌀: 국내산", "닭고기: 국내산"],
                      "nutrition": ["탄수화물(g): 92.1", "단백질(g): 31.4"],
                      "calories": "742.3 Kcal",
                      "servingCount": 530
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "필수 파라미터 누락, 잘못된 날짜 형식, 또는 역순이거나 직전 달 1일~오늘 범위를 벗어난 날짜 범위",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetail" },
                "examples": {
                  "invalidRequest": {
                    "summary": "필수 파라미터 누락 또는 잘못된 날짜 형식",
                    "value": {
                      "type": "https://example.invalid/problems/invalid-request",
                      "title": "Invalid request",
                      "status": 400,
                      "detail": "요청 파라미터가 올바르지 않습니다.",
                      "instance": "/api/v1/schools/7010113/meals",
                      "code": "INVALID_REQUEST",
                      "errors": { "from": ["from은 YYYY-MM-DD 형식이어야 합니다."] }
                    }
                  },
                  "invalidDateRange": {
                    "summary": "역순이거나 허용 범위를 벗어난 날짜",
                    "value": {
                      "type": "https://example.invalid/problems/invalid-date-range",
                      "title": "Invalid date range",
                      "status": 400,
                      "detail": "조회 기간은 직전 달 1일부터 오늘까지의 범위여야 합니다.",
                      "instance": "/api/v1/schools/7010113/meals",
                      "code": "INVALID_DATE_RANGE",
                      "errors": { "to": ["오늘 이후 날짜는 선택할 수 없습니다."] }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "조회 대상 학교를 확인할 수 없는 경우",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetail" },
                "example": {
                  "type": "https://example.invalid/problems/school-not-found",
                  "title": "School not found",
                  "status": 404,
                  "detail": "요청한 학교를 확인할 수 없습니다.",
                  "instance": "/api/v1/schools/7010113/meals",
                  "code": "SCHOOL_NOT_FOUND"
                }
              }
            }
          },
          "429": {
            "description": "요청이 제한된 경우",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetail" }
              }
            }
          },
          "502": {
            "description": "NEIS가 처리 불가능한 오류를 반환한 경우",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetail" }
              }
            }
          },
          "503": {
            "description": "NEIS 연결 실패 또는 타임아웃",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetail" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string", "enum": ["ok"] }
        }
      },
      "SchoolSearchResponse": {
        "type": "object",
        "required": ["items", "total"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SchoolSummary" }
          },
          "total": { "type": "integer", "minimum": 0 }
        }
      },
      "SchoolSummary": {
        "type": "object",
        "required": [
          "schoolCode",
          "educationOfficeCode",
          "schoolName",
          "educationOfficeName",
          "locationName",
          "schoolType"
        ],
        "properties": {
          "schoolCode": { "type": "string" },
          "educationOfficeCode": { "type": "string" },
          "schoolName": { "type": "string" },
          "educationOfficeName": { "type": "string" },
          "locationName": { "type": "string", "nullable": true },
          "schoolType": { "type": "string", "nullable": true }
        }
      },
      "MealRangeResponse": {
        "type": "object",
        "required": ["school", "from", "to", "meals"],
        "properties": {
          "school": { "$ref": "#/components/schemas/SelectedSchool" },
          "from": { "type": "string", "format": "date" },
          "to": { "type": "string", "format": "date" },
          "meals": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Meal" }
          }
        }
      },
      "SelectedSchool": {
        "type": "object",
        "required": [
          "schoolCode",
          "educationOfficeCode",
          "schoolName",
          "educationOfficeName"
        ],
        "properties": {
          "schoolCode": { "type": "string" },
          "educationOfficeCode": { "type": "string" },
          "schoolName": { "type": "string" },
          "educationOfficeName": { "type": "string" }
        }
      },
      "Meal": {
        "type": "object",
        "required": [
          "date",
          "mealType",
          "dishes",
          "origins",
          "nutrition",
          "calories",
          "servingCount"
        ],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "mealType": { "type": "string", "enum": ["lunch"] },
          "dishes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "origins": { "type": "array", "items": { "type": "string" } },
          "nutrition": { "type": "array", "items": { "type": "string" } },
          "calories": { "type": "string", "nullable": true },
          "servingCount": { "type": "integer", "minimum": 0, "nullable": true }
        }
      },
      "ProblemDetail": {
        "type": "object",
        "required": ["type", "title", "status", "detail", "code"],
        "properties": {
          "type": { "type": "string", "format": "uri" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" },
          "instance": { "type": "string" },
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST",
              "INVALID_DATE_RANGE",
              "SCHOOL_NOT_FOUND",
              "RATE_LIMITED",
              "UPSTREAM_ERROR",
              "UPSTREAM_UNAVAILABLE",
              "INTERNAL_ERROR"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
