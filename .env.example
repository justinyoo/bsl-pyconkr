# 이 파일을 복사해 `.env`로 사용하세요. 실제 비밀 값은 `.env`에만 두고
# 커밋하지 않습니다(`.env`는 .gitignore에 등록되어 있어야 합니다).
#
# 사용법:
#   cp .env.example .env
#   docker compose up --build

# NEIS Open API 인증키. https://open.neis.go.kr 에서 발급받습니다.
# NEIS_FIXTURE_MODE=true인 경우 이 값 없이도 애플리케이션이 기동합니다.
NEIS_API_KEY=

# NEIS API 호스트. 특별한 사유가 없다면 기본값을 사용합니다.
NEIS_BASE_URL=https://open.neis.go.kr

# NEIS 호출 타임아웃(초).
NEIS_TIMEOUT_SECONDS=15

# true로 설정하면 실제 NEIS 호출 대신 결정적인 고정 데이터를 반환합니다.
# NEIS_API_KEY 없이 로컬 데모나 E2E 테스트를 실행할 때 사용합니다.
NEIS_FIXTURE_MODE=false

# true로 설정하면 Copilot LLM 호출 대신 결정적인 에이전트 응답을 사용합니다.
# 로컬 E2E와 UI 데모에서만 사용하세요.
AGENT_FIXTURE_MODE=false

# 선택 사항. 비워 두면 Copilot SDK의 기본 모델을 사용합니다.
COPILOT_MODEL=

# 백엔드 CORS 허용 origin(쉼표로 구분). 프론트엔드 컨테이너는 nginx가
# 같은 origin에서 /api를 프록시하므로 개발 시에만 필요합니다.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# 애플리케이션 로그 수준.
LOG_LEVEL=INFO

# 호스트에 노출할 포트(선택). 다른 서비스와 충돌하면 값을 바꾸세요.
BACKEND_PORT=8000
FRONTEND_PORT=5173
MCP_PORT=8001
AGENT_PORT=8002
